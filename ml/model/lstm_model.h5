import numpy as np
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense, Dropout
import joblib
import os

# 1. Create a 10,000-row Synthetic Indian Dataset (Sequence-based)
def generate_synthetic_data(n_samples=10000, seq_len=5):
    # Features: [Amount_INR, Hour, Amount_Deviation, Transaction_Frequency]
    X = np.random.rand(n_samples, seq_len, 4) 
    y = np.zeros(n_samples)
    
    for i in range(n_samples):
        # Pattern: High Amount + Late Night (₹75k+ at 2 AM)
        if np.random.random() > 0.9:
            X[i, -1, 0] = np.random.uniform(0.7, 1.0) # High scaled amount
            X[i, -1, 1] = np.random.uniform(0.0, 0.2) # 2 AM - 4 AM
            y[i] = 1
        # Pattern: Velocity Spike
        elif np.random.random() > 0.95:
            X[i, :, 3] = np.random.uniform(0.8, 1.0) 
            y[i] = 1
            
    return X, y

# 2. Build and Train
X, y = generate_synthetic_data()
model = Sequential([
    LSTM(64, input_shape=(5, 4), return_sequences=False),
    Dropout(0.2),
    Dense(32, activation='relu'),
    Dense(1, activation='sigmoid')
])

model.compile(optimizer='adam', loss='binary_crossentropy', metrics=['accuracy'])
model.fit(X, y, epochs=10, batch_size=32, verbose=1)

# 3. Save Artifacts
os.makedirs('ml/model', exist_ok=True)
model.save('ml/model/lstm_model.h5')
# We still save a dummy scaler so the service file doesn't crash
from sklearn.preprocessing import MinMaxScaler
scaler = MinMaxScaler()
scaler.fit(np.random.rand(10, 4))
joblib.dump(scaler, 'ml/model/scaler.pkl')

print("✅ Model trained on synthetic data and saved.")