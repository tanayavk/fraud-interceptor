{
  "manifest_version": 3,
  "name": "Fraud Interceptor",
  "version": "1.0",
  "description": "Real-time fraud prevention for net banking transactions.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "file:///*"
  ],
  "content_scripts": [
    {
      "matches": ["file:///*", "http://127.0.0.1:*/*", "http://localhost:*/*"],
      "js": ["content.js"],
      "css": ["modal.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fraud Interceptor"
  }
}